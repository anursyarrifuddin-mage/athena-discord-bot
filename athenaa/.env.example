# ============================================================================
# ATHENAA v5.4 SUPERPOWERS — DISCORD BOT & WEB REMOTE CONTROL CONFIGURATION
# Hosting Pterodactyl: 185-128-227-130.raznar-ip.my.id:10031
# Domain Publik: https://bot.athenaa.my.id
# ============================================================================

# Server Web & URL Dasar (Port Pterodactyl: 10031)
WEB_HOST=0.0.0.0
WEB_PORT=8000 #default local 8000 atau 3000 ganti dengan port di hosting anda atau ganti
WEB_BASE_URL=https://yourdomain.com #ganti dengan domain anda

# Kredensial Bot Discord & OAuth2 Dashboard (Multi-Device Sync)
DISCORD_TOKEN= #Ganti dengan token bot discord anda
DISCORD_CLIENT_ID= #Ganti dengan client id bot discord anda
DISCORD_CLIENT_SECRET= #Ganti dengan client secret bot discord anda
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/callback

# ID Server & Channel Pengingat Tugas Default
MAIN_GUILD_ID= #Ganti dengan ID server discord anda
OWNER_DISCORD_ID= #Ganti dengan ID discord anda
DJ_ROLE_ID= #Ganti dengan ID role DJ di server discord anda
TASK_REMINDER_CHANNEL_ID= #Ganti dengan ID channel pengingat tugas di server discord anda

# ============================================================================
# MULTI-KEY GEMINI API ROTATOR & AI CHATBOT (@Athena Mention + Autoplay)
# ============================================================================
AI_AUTOPLAY_ENABLED=true #(true/false) Aktifkan Autoplay AI Chatbot (Gemini API)
AI_AUTOPLAY_MODEL=gemini-3.8-flash
AI_AUTOPLAY_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Masukkan 1 atau lebih API Key Gemini Free Tier (pisahkan dengan koma pada GEMINI_API_KEYS
# atau isi GEMINI_API_KEY_1, GEMINI_API_KEY_2, dst.). Jika Key #1 terkena limit (429),
# bot otomatis beralih ke Key #2 dan seterusnya tanpa henti!
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ============================================================================
# TAUTAN MUSIK /AMBIENCE KUSTOM (.env Configurable Direct Links)
# ============================================================================
AMBIENCE_RAIN_URL=https://www.youtube.com/watch?v=jfKfPfyJRdk
AMBIENCE_CAFE_URL=https://www.youtube.com/watch?v=lP26UCnoH9s
AMBIENCE_LOFI_URL=https://www.youtube.com/watch?v=5qap5aO4i9A
AMBIENCE_NIGHT_CODING_URL=https://www.youtube.com/watch?v=4xDzrJKXOOY
AMBIENCE_PIANO_URL=https://www.youtube.com/watch?v=1ZYbU82GVz4

# ============================================================================
# OPTIMASI RAM & PERFORMA KONTAINER PTERODACTYL (RAM Optimizer Engine)
# ============================================================================
LOW_MEMORY_MODE=true
AUDIO_CACHE_MAX_FILES=5
AUDIO_CACHE_MAX_MB=60
GC_INTERVAL_SECONDS=180
FFMPEG_THREADS=1

# Kustomisasi Branding
CUSTOM_LOGO_URL=https://assets.athenaa.internal/logo.png #Ganti dengan URL logo kustom anda (opsional)

# Database Persisten (SQLite default untuk single-instance / Pterodactyl)
DATABASE_URL=sqlite+aiosqlite:///./data/athenaa.db

# Keamanan Sesi & Enkripsi
SESSION_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Pengaturan Akademik, Waskita LMS (.ics & Kredensial Login), & Lampiran Modul
DEFAULT_TIMEZONE=Asia/Jakarta
MAX_ATTACHMENT_MB=15 #Maksimal ukuran lampiran modul (MB)
MOODLE_BASE_URL=
MOODLE_ICAL_URL=
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Integrasi Google Classroom OAuth2 (Opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback

# Level Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
