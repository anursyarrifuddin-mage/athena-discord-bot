# ============================================================================
# ATHENAA DISCORD BOT & WEB DASHBOARD — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to git!
# ============================================================================

# -----------------------------------------------------------------------------
# SERVER & DEPLOYMENT
# -----------------------------------------------------------------------------
# Web server bind (Pterodactyl allocates port via SERVER_PORT env)
WEB_HOST=0.0.0.0
WEB_PORT=xxxxx
# Public base URL for OAuth2 redirects & asset loading (MUST match Discord OAuth2 redirect)
WEB_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# DISCORD BOT & OAUTH2 (REQUIRED)
# -----------------------------------------------------------------------------
# Bot Token (from Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=your_bot_token_here

# OAuth2 Application (Discord Developer Portal → OAuth2 → General)
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# MUST match exactly the redirect URI in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=https://your-domain.com/auth/callback

# -----------------------------------------------------------------------------
# GUILD & PERMISSIONS (REQUIRED)
# -----------------------------------------------------------------------------
# Target Discord Server ID (right-click server → Copy Server ID)
MAIN_GUILD_ID=1428666546942902294
# Your Discord User ID (right-click your profile → Copy User ID) — gets Owner privileges
OWNER_DISCORD_ID=844174494099701780
# DJ Role ID (create role in Discord → right-click → Copy Role ID) — for music control
DJ_ROLE_ID=1563848335247417395
# Channel ID for task reminders (right-click channel → Copy Channel ID)
TASK_REMINDER_CHANNEL_ID=1558142572164022362

# -----------------------------------------------------------------------------
# BRANDING (OPTIONAL)
# -----------------------------------------------------------------------------
# Custom logo URL (shown in dashboard top bar, login modal, sidebar)
CUSTOM_LOGO_URL=https://your-cdn.com/logo.png

# -----------------------------------------------------------------------------
# DATABASE (SQLite — single file, auto-created)
# -----------------------------------------------------------------------------
# Relative to athenaa/ working directory
DATABASE_URL=sqlite+aiosqlite:///./data/athenaa.db

# -----------------------------------------------------------------------------
# SESSION & ENCRYPTION SECRETS (REQUIRED — generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
# Session signing (JWT/cookie) — 64 hex chars (32 bytes)
SESSION_SECRET=3d9b56a8f32338010504eec54270050d58c68eaaccb16d26f2ac27c03e0a90c7
# Data encryption (AES-GCM) — 64 hex chars
ENCRYPTION_KEY=3d9b56a8f32338010504eec54270050d58c68eaaccb16d26f2ac27c03e0a90c7
# Backup encryption (separate key recommended) — 64 hex chars
BACKUP_ENCRYPTION_KEY=3d9b56a8f32338010504eec54270050d58c68eaaccb16d26f2ac27c03e0a90c7

# -----------------------------------------------------------------------------
# ACADEMIC / MOODLE / WASKITA INTEGRATION (OPTIONAL but recommended)
# -----------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Jakarta
MAX_ATTACHMENT_MB=15

# Moodle/Waskita base URL (for link construction)
MOODLE_BASE_URL=https://waskita.amikom.ac.id/

# Option A: iCal Export URL (from Moodle: Calendar → Export → iCal link with authtoken)
# Get this by: Login Moodle → Calendar → Export → "All events" → Copy link
MOODLE_ICAL_URL=https://waskita.amikom.ac.id/calendar/export_execute.php?userid=YOUR_USER_ID&authtoken=YOUR_AUTHTOKEN&preset_what=all&preset_time=custom

# Option B: Moodle Credentials (for login-based sync if iCal not available)
MOODLE_USERNAME=your_student_id
MOODLE_PASSWORD=your_password

# -----------------------------------------------------------------------------
# GOOGLE CLASSROOM OAUTH2 (OPTIONAL — not fully implemented yet)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/callback

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# GENERATION HELPERS (run these in terminal to generate secure keys):
# ============================================================================
# SESSION_SECRET:        openssl rand -hex 32
# ENCRYPTION_KEY:        openssl rand -hex 32
# BACKUP_ENCRYPTION_KEY: openssl rand -hex 32
#
# All three should be DIFFERENT for defense-in-depth.
# ============================================================================